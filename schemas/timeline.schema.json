{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chien-video-studio.local/schemas/timeline.schema.json",
  "title": "Video Timeline IR",
  "type": "object",
  "required": ["video_id", "fps", "width", "height", "scenes"],
  "properties": {
    "video_id": {"type": "string"},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "duration"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": ["string", "null"]},
          "start": {"type": "number", "minimum": 0},
          "duration": {"type": "number", "exclusiveMinimum": 0},
          "layout": {"type": ["string", "null"]},
          "motion": {"type": ["string", "null"]},
          "registry_ref": {"type": ["string", "null"]},
          "assets": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
